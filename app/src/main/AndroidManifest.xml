<?xml version="1.0" encoding="utf-8"?>
<!--
    No <uses-permission> on purpose: no INTERNET, no SYSTEM_ALERT_WINDOW.
    The overlay uses TYPE_ACCESSIBILITY_OVERLAY, which the accessibility service
    grants by itself. allowBackup=false keeps settings off cloud backups.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FloatMenu">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            BIND_ACCESSIBILITY_SERVICE here is a guard (only the system can bind),
            not a permission the app requests.
        -->
        <service
            android:name=".FloatMenuService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
